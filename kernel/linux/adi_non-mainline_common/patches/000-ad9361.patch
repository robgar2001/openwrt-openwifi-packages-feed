 {
 	struct ad9361_rf_phy_state *st = phy->state;
 	int ret, ret2;
@@ -5284,6 +5289,7 @@

 	return ret ? ret : ret2;
 }
+EXPORT_SYMBOL(ad9361_do_calib_run);

